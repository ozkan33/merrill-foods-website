---
import { hero } from '../site.config';
import Button from './Button.astro';

// Vite resolves these to hashed, cache-busted URLs at build time.
// `heroVideo` is a plain URL string; `poster` is an ImageMetadata object.
import heroVideo from '../assets/hero.mp4';
import poster from '../assets/hero-poster.jpg';

// Split the headline on newlines so we can emphasize the second line.
const lines = hero.headline.split('\n');
---

<section class="relative flex min-h-[100svh] items-center overflow-hidden">
  <!-- Background video (muted, looping, no controls). Poster paints first as
       the LCP image; the video is deferred and enhances progressively. -->
  <video
    class="absolute inset-0 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="none"
    poster={poster.src}
    aria-hidden="true"
    tabindex="-1"
  >
    <source src={heroVideo} type="video/mp4" />
  </video>

  <!-- Readability scrim: darken + warm gradient for AA text contrast. -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-espresso/70 via-forest/55 to-espresso/80"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 bg-[radial-gradient(120%_80%_at_50%_0%,transparent_40%,rgba(20,52,43,0.55)_100%)]"
    aria-hidden="true"
  >
  </div>

  <!-- Content -->
  <div class="relative mx-auto w-full max-w-6xl px-6 py-28 sm:px-8 sm:py-32">
    <div class="max-w-2xl">
      <p
        class="reveal mb-5 inline-flex items-center gap-2 rounded-full border border-cream/25 bg-cream/5 px-4 py-1.5 text-xs font-medium uppercase tracking-[0.18em] text-cream/90 backdrop-blur-sm"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-amber"></span>
        Restaurant &amp; specialty retail
      </p>

      <h1
        class="reveal text-4xl font-semibold leading-[1.05] text-cream sm:text-5xl lg:text-6xl"
        style="--reveal-delay:80ms"
      >
        {lines[0]}
        {lines[1] && <span class="block text-amber">{lines[1]}</span>}
      </h1>

      <p
        class="reveal mt-6 max-w-xl text-base leading-relaxed text-cream/85 sm:text-lg"
        style="--reveal-delay:160ms"
      >
        {hero.subhead}
      </p>

      <div class="reveal mt-9 flex flex-wrap gap-4" style="--reveal-delay:240ms">
        <Button href={hero.ctaHref} variant="primary">
          {hero.ctaLabel}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </Button>
        <Button href="/about" variant="outline" class="text-cream">
          Our story
        </Button>
      </div>
    </div>
  </div>

  <!-- Scroll cue -->
  <div
    class="absolute inset-x-0 bottom-6 flex justify-center text-cream/60"
    aria-hidden="true"
  >
    <svg class="animate-bounce" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14M6 13l6 6 6-6" />
    </svg>
  </div>
</section>

<script>
  // Defer video loading: only fetch/play once the hero is on-screen, and honor
  // reduced-motion + Save-Data. Keeps the poster as the fast LCP image.
  const video = document.querySelector<HTMLVideoElement>('section video');
  if (video) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = (navigator as any).connection?.saveData === true;

    if (reduceMotion || saveData) {
      // Leave the poster in place; do not load the video.
      video.removeAttribute('autoplay');
    } else {
      const start = () => {
        video.preload = 'auto';
        video.load();
        video.play().catch(() => {/* autoplay may be blocked; poster remains */});
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries, obs) => {
          if (entries[0].isIntersecting) {
            start();
            obs.disconnect();
          }
        });
        io.observe(video);
      } else {
        start();
      }
    }
  }
</script>
