---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Reveal from '../components/Reveal.astro';
import Button from '../components/Button.astro';
import { about, company } from '../site.config';
---

<BaseLayout
  title="About"
  description={`The story behind ${company.name} — how we source, why we exist, and what sets our specialty food distribution apart.`}
>
  <!-- Page header (offset for the solid navbar) -->
  <Section tone="cream" width="narrow" class="pt-32 sm:pt-36">
    <Reveal class="text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-600">
        {about.eyebrow}
      </p>
      <h1 class="mt-3 text-4xl font-semibold text-espresso sm:text-5xl">
        {about.heading}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink/75">
        {about.lead}
      </p>
    </Reveal>
  </Section>

  <!-- Story + stats -->
  <Section tone="cream" class="!pt-0">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:items-center">
      <Reveal class="space-y-5 text-lg leading-relaxed text-ink/80">
        {about.body.map((para) => <p>{para}</p>)}
      </Reveal>

      <Reveal class="grid grid-cols-2 gap-4" delay={120}>
        {
          about.stats.map((s) => (
            <div class="flex h-full flex-col items-center justify-center rounded-2xl border border-cream-200 bg-white/60 p-4 text-center sm:p-6">
              <div class="font-serif text-xl font-semibold leading-tight text-balance hyphens-auto text-forest sm:text-[1.7rem]">
                {s.value}
              </div>
              <div class="mt-1.5 text-xs text-ink/60 text-balance sm:text-sm">{s.label}</div>
            </div>
          ))
        }
      </Reveal>
    </div>
  </Section>

  <!-- Mission -->
  <Section tone="forest">
    <Reveal class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber">
        {about.mission.heading}
      </p>
      <p class="mt-5 font-serif text-2xl leading-snug text-cream sm:text-3xl text-balance">
        {about.mission.body}
      </p>
    </Reveal>
  </Section>

  <!-- Values -->
  <Section tone="cream">
    <Reveal class="max-w-2xl">
      <h2 class="text-3xl font-semibold text-espresso sm:text-4xl">
        What sets us apart
      </h2>
      <p class="mt-4 text-lg text-ink/70">
        The principles behind every order we pack and every producer we partner with.
      </p>
    </Reveal>

    <div class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2">
      {
        about.values.map((v, i) => (
          <Reveal class="flex gap-5" delay={i * 80}>
            <span
              class="mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-amber/15 font-serif text-sm font-semibold text-amber-600"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="text-xl font-semibold text-espresso">{v.title}</h3>
              <p class="mt-2 leading-relaxed text-ink/75">{v.body}</p>
            </div>
          </Reveal>
        ))
      }
    </div>
  </Section>

  <!-- CTA -->
  <Section tone="espresso">
    <Reveal class="mx-auto flex max-w-3xl flex-col items-center gap-6 text-center">
      <h2 class="text-3xl font-semibold text-cream sm:text-4xl text-balance">
        Become part of the story.
      </h2>
      <p class="max-w-xl text-lg text-cream/75">
        We’d love to learn about your business and what you’re looking for.
      </p>
      <Button href="/contact" variant="primary">Become a Partner</Button>
    </Reveal>
  </Section>
</BaseLayout>
