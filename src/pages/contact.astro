---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Reveal from '../components/Reveal.astro';
import ContactForm from '../components/ContactForm.astro';
import { contact, contactPage, company } from '../site.config';

const { address, hours } = contact;
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${company.name} to become a wholesale partner. Reach our team by form, phone, or email.`}
>
  <Section tone="cream" class="pt-32 sm:pt-36">
    <!-- Header -->
    <Reveal class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-600">
        {contactPage.eyebrow}
      </p>
      <h1 class="mt-3 text-4xl font-semibold text-espresso sm:text-5xl">
        {contactPage.heading}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink/75">
        {contactPage.lead}
      </p>
    </Reveal>

    <div class="mt-14 grid gap-12 lg:grid-cols-[1.3fr_1fr]">
      <!-- Form -->
      <Reveal class="rounded-3xl border border-cream-200 bg-white/70 p-7 shadow-sm sm:p-9">
        <ContactForm />
      </Reveal>

      <!-- Details -->
      <Reveal delay={120} class="space-y-8">
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-600">
            Visit / ship to
          </h2>
          <address class="mt-3 not-italic leading-relaxed text-ink/80">
            {address.line1}<br />
            {address.line2 && <>{address.line2}<br /></>}
            {address.city}, {address.state} {address.zip}
          </address>
        </div>

        <div>
          <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-600">
            Talk to us
          </h2>
          <div class="mt-3 space-y-1">
            <p>
              <a class="text-ink/80 transition-colors hover:text-amber-600" href={contact.phoneHref}>
                {contact.phone}
              </a>
            </p>
            <p>
              <a class="text-ink/80 transition-colors hover:text-amber-600" href={`mailto:${contact.email}`}>
                {contact.email}
              </a>
            </p>
          </div>
        </div>

        <div>
          <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-600">
            Hours
          </h2>
          <dl class="mt-3 space-y-1.5 text-ink/80">
            {
              hours.map((h) => (
                <div class="flex justify-between gap-6 border-b border-cream-200 pb-1.5">
                  <dt>{h.days}</dt>
                  <dd class="text-ink/60">{h.time}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </Reveal>
    </div>
  </Section>

  <!-- Map -->
  <Section tone="cream" class="!pt-0" width="wide">
    <Reveal class="overflow-hidden rounded-3xl border border-cream-200 shadow-sm">
      {
        contact.mapEmbedSrc ? (
          <iframe
            title={`Map to ${company.name}`}
            src={contact.mapEmbedSrc}
            class="h-[420px] w-full"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          />
        ) : (
          <!-- TODO: paste a Google Maps embed URL into `contact.mapEmbedSrc`
               in src/site.config.ts to replace this placeholder. -->
          <div class="flex h-[420px] w-full flex-col items-center justify-center gap-2 bg-forest/5 text-center text-ink/50">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 21s-7-5.686-7-11a7 7 0 1 1 14 0c0 5.314-7 11-7 11Z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
            <p class="font-medium">Map embed placeholder</p>
            <p class="text-sm">Add a Google Maps URL in <code>site.config.ts</code></p>
          </div>
        )
      }
    </Reveal>
  </Section>
</BaseLayout>
