---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Reveal from '../components/Reveal.astro';
import Button from '../components/Button.astro';
import { features, supply, closingCta } from '../site.config';

// Imported only to preload the hero poster as the LCP image.
import poster from '../assets/hero-poster.jpg';
---

<BaseLayout navOverlay={true} preloadPoster={poster.src}>
  <Hero />

  <!-- Value props -->
  <Section id="why" tone="cream">
    <Reveal class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-600">
        Why partners choose us
      </p>
      <h2 class="mt-3 text-3xl font-semibold text-espresso sm:text-4xl">
        A distributor that works like part of your team.
      </h2>
      <p class="mt-4 text-lg text-ink/70">
        Four things we never compromise on — because your reputation depends on them.
      </p>
    </Reveal>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((f, i) => (
          <Reveal class="h-full" delay={i * 90}>
            <Card title={f.title} icon={f.icon}>
              {f.body}
            </Card>
          </Reveal>
        ))
      }
    </div>
  </Section>

  <!-- What we supply -->
  <Section tone="forest">
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_1.4fr]">
      <Reveal>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber">
          The catalog
        </p>
        <h2 class="mt-3 text-3xl font-semibold text-cream sm:text-4xl">
          {supply.heading}
        </h2>
        <p class="mt-4 max-w-md text-lg leading-relaxed text-cream/75">
          {supply.intro}
        </p>
        <Button href="/contact" variant="primary" class="mt-8">
          Request the full catalog
        </Button>
      </Reveal>

      <div class="grid gap-px overflow-hidden rounded-2xl border border-cream/15 bg-cream/10 sm:grid-cols-2">
        {
          supply.categories.map((c, i) => (
            <Reveal delay={i * 60} class="h-full">
              <div class="group flex h-full flex-col gap-1 bg-forest p-6 transition-colors hover:bg-forest-700">
                <span class="text-base font-semibold text-cream">{c.name}</span>
                <span class="text-sm text-cream/60">{c.blurb}</span>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Closing CTA band -->
  <Section tone="espresso">
    <Reveal class="mx-auto flex max-w-3xl flex-col items-center gap-6 text-center">
      <h2 class="text-3xl font-semibold text-cream sm:text-4xl text-balance">
        {closingCta.heading}
      </h2>
      <p class="max-w-xl text-lg text-cream/75">{closingCta.body}</p>
      <Button href={closingCta.ctaHref} variant="primary">
        {closingCta.ctaLabel}
      </Button>
    </Reveal>
  </Section>
</BaseLayout>
